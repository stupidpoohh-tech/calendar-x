# Firebase 웹 앱 설정 — Firebase 콘솔 > 프로젝트 설정 > 내 앱에서 복사합니다.
# 이 값들은 클라이언트 번들에 포함되며 공개되어도 무방합니다.
# 실제 보안 경계는 firestore.rules 입니다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 로컬 개발 시 Firebase 에뮬레이터에 연결하려면 1로 설정합니다.
VITE_USE_EMULATOR=0
