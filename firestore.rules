rules_version = '2';

/**
 * Firestore 보안 규칙.
 *
 * 이전에는 이 파일이 레포 밖(콘솔)에만 있었다. 서비스의 보안 경계 전체가 버전 관리
 * 밖에 있었다는 뜻이고, 규칙이 무엇을 막는지 확인할 방법이 없어 "저장은 되는데 조용히
 * 사라지는" 문제를 title 을 '::balance::' 로 쓰는 우회로 넘겼다.
 *
 * 여기서는 두 가지를 지킨다.
 *   1. 남의 데이터에 손댈 수 없다. 경로의 uid 와 로그인한 uid 가 같아야 한다.
 *   2. 거부할 때는 형태가 틀렸을 때만 거부한다. 필드를 통째로 화이트리스트해서
 *      새 필드가 조용히 막히는 일이 없도록, 필수 필드의 타입만 확인한다.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function data() {
      return request.resource.data;
    }

    function isDateISO(v) {
      return v is string && v.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isTimeOrNull(v) {
      return v == null || (v is string && v.matches('^\\d{2}:\\d{2}$'));
    }

    // 한 문서가 지나치게 커지는 것을 막는다. 이전 구조는 대출 목록 전체를
    // 한 문서의 memo 에 JSON 으로 넣었고, 그래서 다중 기기 덮어쓰기가 났다.
    function withinSize() {
      return data().size() < 60;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /entries/{entryId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && withinSize()
          && data().kind in ['task', 'idea', 'money']
          && data().title is string && data().title.size() <= 500
          && data().note is string && data().note.size() <= 20000
          && data().color is string
          && data().tags is list && data().tags.size() <= 50
          && isDateISO(data().startDate)
          && (data().endDate == null || isDateISO(data().endDate))
          && isTimeOrNull(data().startTime)
          && isTimeOrNull(data().endTime)
          && data().ymSpan is list && data().ymSpan.size() <= 200
          && data().isRecurring is bool
          && (data().money == null || (
               data().money.amountMinor is int
               && data().money.currency is string
             ))
          // 같이 보기에 올리지 않는 표시. 옛 문서에는 없고 그것이 정상이다.
          && (!('keepPrivate' in data()) || data().keepPrivate is bool);
      }

      match /accounts/{accountId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && withinSize()
          && data().name is string && data().name.size() <= 100
          && data().balanceMinor is int
          && data().currency is string
          && isDateISO(data().asOf)
          // checkedAt 은 정산 계산 기준점. 없으면 asOf 자정으로 폴백되므로
          // 규칙에서는 선택 항목으로 두되 형태만 본다.
          && (data().checkedAt == null
              || (data().checkedAt is string && data().checkedAt.size() <= 40));
      }

      match /debts/{debtId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && withinSize()
          && data().name is string && data().name.size() <= 100
          && data().balanceMinor is int
          && data().monthlyMinor is int
          && (data().rate == null || data().rate is number);
      }

      match /budgets/{budgetId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && withinSize()
          && data().name is string && data().name.size() <= 100
          && data().amountMinor is int
          && data().currency is string
          && isDateISO(data().startDate)
          && isDateISO(data().endDate);
      }

      match /reserves/{reserveId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && withinSize()
          && data().name is string && data().name.size() <= 100
          && data().amountMinor is int
          && data().currency is string;
      }

      match /pins/{pinId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && withinSize()
          && data().lens in ['task', 'idea', 'money']
          && data().text is string && data().text.size() <= 2000;
      }

      // 이관 전 컬렉션. 읽고 지울 수는 있지만 새로 쓸 수는 없다.
      // 이관이 끝난 뒤 사용자가 직접 정리할 때까지 원본으로 남겨 둔다.
      match /items/{itemId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if false;
      }
    }

    /* ==========================================================================
       같이 보기 (공유 보드)
       ==========================================================================

       개인 경로 **밖**에 둔다. `users/{uid}` 아래에 두면 TODO 하나를 보여 주려고 그
       사용자 영역을 열어야 하고, 그러면 아이디어 · 가계부 · 대출 · 잔고 · 회복까지
       함께 열린다. 위의 `users/{uid}` 규칙은 이 기능을 넣으면서 **한 글자도 느슨해지지
       않았다** — 상대는 여전히 남의 `users/{uid}` 를 읽지도 쓰지도 못한다.

       초대는 세 걸음이다.
         1. 소유자가 `sharedInvites/{code}` 를 만든다 (code 는 100비트 난수).
         2. 링크를 받은 사람이 **로그인**해서 그 문서를 읽는다 — 코드를 모르면 찾을 수
            없다 (목록 조회는 소유자에게만 열려 있다).
         3. 보드에 자기 uid 하나를 더한다. 규칙이 그 코드의 초대장이 이 보드의 것인지
            확인한다.
    */

    function boardData(boardId) {
      return get(/databases/$(database)/documents/sharedBoards/$(boardId)).data;
    }

    function isBoardMember(boardId) {
      return signedIn()
        && exists(/databases/$(database)/documents/sharedBoards/$(boardId))
        && request.auth.uid in boardData(boardId).memberUids;
    }

    /** 이 코드의 초대장이 이 보드로 가는 것인가. 코드를 아는 것이 초대장의 전부다. */
    function invitedTo(boardId, code) {
      return code is string
        && exists(/databases/$(database)/documents/sharedInvites/$(code))
        && get(/databases/$(database)/documents/sharedInvites/$(code)).data.boardId == boardId;
    }

    /** 보드 하나에 들어갈 수 있는 사람 수. `MAX_BOARD_MEMBERS` 와 같은 값이다. */
    function memberLimit() { return 4; }

    match /sharedBoards/{boardId} {

      /*
        수락 — **자기 uid 하나만** 더한다.

        아직 member 가 아니므로 보드를 읽을 수 없고, 그래서 클라이언트는 `arrayUnion` 과
        점 표기법으로 두 칸만 쓴다. 소유자 · 이름 · 만든 시각은 건드릴 수 없고, 소유자의
        이름표도 그대로여야 한다.
      */
      function joinsSelf() {
        return signedIn()
          && !(request.auth.uid in resource.data.memberUids)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['memberUids', 'memberNames', 'joinCode', 'updatedAt'])
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids
               .hasOnly(resource.data.memberUids.concat([request.auth.uid]))
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.memberUids.size() <= memberLimit()
          && request.resource.data.memberNames.get(resource.data.ownerUid, '')
               == resource.data.memberNames.get(resource.data.ownerUid, '')
          && invitedTo(boardId, request.resource.data.joinCode);
      }

      /** 나가기 — 자기만 뺀다. 소유자는 이 길을 쓰지 않는다 (보드를 지운다). */
      function leavesSelf() {
        return signedIn()
          && request.auth.uid in resource.data.memberUids
          && request.auth.uid != resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['memberUids', 'memberNames', 'updatedAt'])
          && !(request.auth.uid in request.resource.data.memberUids)
          && resource.data.memberUids.hasAll(request.resource.data.memberUids);
      }

      /*
        소유자의 수정. 소유자는 바뀌지 않고, 자기를 목록에서 뺄 수도 없다 —
        빼면 자기 보드를 읽지 못하는 문서가 남는다.
      */
      function ownerEdits() {
        return request.auth.uid == resource.data.ownerUid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.memberUids.size() <= memberLimit()
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 100;
      }

      // member 만 읽는다. `array-contains` 조회와 같은 모양이라 목록 조회도 통과한다.
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;

      allow create: if signedIn()
        && withinSize()
        && data().ownerUid == request.auth.uid
        // 만들 때는 혼자다. 남을 끼워 넣은 보드를 만들 수 없다.
        && data().memberUids == [request.auth.uid]
        && data().memberNames is map
        && data().name is string && data().name.size() <= 100
        && data().createdAt is string && data().updatedAt is string;

      allow update: if signedIn() && withinSize()
        && (ownerEdits() || joinsSelf() || leavesSelf());

      allow delete: if signedIn() && request.auth.uid == resource.data.ownerUid;

      /*
        공유 TODO.

        갱신 쓰기는 `overrides` · `overriddenBy` · `hiddenBy` 를 **담지 않는다** (merge).
        그래서 그 필드가 없는 문서가 정상이고, 규칙도 있을 때만 형태를 본다.
        `money` · `recovery` 같은 개인 자료는 애초에 이 문서에 오지 않는다.

        ── 둘 다 올리므로 자리를 갈라야 한다 ────────────────────────

        member 아무나 아무 필드나 쓸 수 있으면, 상대가 **내 원본 스냅샷을 위조**할 수
        있다. 그리고 그것은 조용히 끝나지도 않는다 — 내 맞추기가 다음에 열 때 되돌려
        놓아서 값이 왔다 갔다 한다. 삭제도 같다. 상대가 내 항목을 지우면 내 맞추기가
        되살려 유령처럼 돌아온다.

          source · sourceEntryId · createdBy   그 항목의 주인만
          overrides · overriddenBy             member 누구나 (보드는 함께 쓰는 자리다)
          hiddenBy                             자기 uid 만 (감추기는 사람별이다)
          삭제                                 원본이 있으면 주인만, 공유 전용은 누구나
      */
      match /items/{itemId} {

        /** 원본에서 온 값을 건드리지 않았는가. */
        function sourceUntouched() {
          return request.resource.data.get('source', null) == resource.data.get('source', null)
            && request.resource.data.get('sourceEntryId', null) == resource.data.get('sourceEntryId', null)
            && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')
            && request.resource.data.get('localOnly', false) == resource.data.get('localOnly', false);
        }

        function ownsIt() {
          return request.auth.uid == resource.data.get('createdBy', '');
        }

        /** 감추기는 **자기 uid 만** 넣고 뺄 수 있다. 남의 화면을 건드리지 못한다. */
        function hidesOnlySelf() {
          return request.resource.data.get('hiddenBy', [])
                   .hasOnly(resource.data.get('hiddenBy', []).concat([request.auth.uid]))
            && resource.data.get('hiddenBy', [])
                 .hasOnly(request.resource.data.get('hiddenBy', []).concat([request.auth.uid]));
        }

        function shapeOk() {
          return withinSize()
            && (!('source' in data()) || data().source == null || (
                 data().source.title is string && data().source.title.size() <= 500
                 && isDateISO(data().source.startDate)
                 && data().source.get('color', '') is string
                 && data().source.get('color', '').size() <= 40
               ))
            && (!('overrides' in data()) || (
                 data().overrides is map
                 && data().overrides.get('title', '') is string
                 && data().overrides.get('title', '').size() <= 500
                 && data().overrides.get('note', '') is string
                 && data().overrides.get('note', '').size() <= 20000
                 && data().overrides.get('color', '') is string
                 && data().overrides.get('color', '').size() <= 40
               ))
            && (!('overriddenBy' in data())
                || (data().overriddenBy is string && data().overriddenBy.size() <= 200))
            && (!('hiddenBy' in data())
                || (data().hiddenBy is list && data().hiddenBy.size() <= memberLimit()))
            && (!('localOnly' in data()) || data().localOnly is bool);
        }

        allow read: if isBoardMember(boardId);

        // 원본을 담아 만드는 것은 그 원본의 주인뿐이다. 공유 전용 항목은 누구나 만든다.
        allow create: if isBoardMember(boardId) && shapeOk()
          && (data().get('source', null) == null || data().get('createdBy', '') == request.auth.uid)
          && data().get('hiddenBy', []).hasOnly([request.auth.uid]);

        allow update: if isBoardMember(boardId) && shapeOk()
          && hidesOnlySelf()
          && (sourceUntouched() || ownsIt());

        // 원본이 있는 항목은 주인만 지운다. 남의 것을 지워 봐야 맞추기가 되살린다.
        allow delete: if isBoardMember(boardId)
          && (resource.data.get('localOnly', false) == true || ownsIt());
      }

      /** 공유 고정메모. 개인 `users/{uid}/pins` 와 다른 자료다. */
      /*
        옛 고정메모.

        고정메모는 이제 메모 글 하나를 세우는 것이다(`notes` 의 `pinned`). 이 자리는
        그 구조 이전에 적어 둔 글을 **읽고 지우기 위해** 남겨 둔다 — 규칙에서 먼저
        치우면 옮기지도 지우지도 못하는 문서가 남는다.
      */
      match /pins/{pinId} {
        allow read, delete: if isBoardMember(boardId);
        allow create, update: if isBoardMember(boardId)
          && withinSize()
          && data().text is string && data().text.size() <= 4000;
      }

      /*
        함께 할 것 — 목록과 항목.

        보드는 둘이 함께 쓰는 자리라 member 면 누구나 만들고 고치고 지운다. 공유 일정과
        달리 '원본' 이 없으므로 주인별로 가를 것이 없다 — 여기서 갈라 봐야 상대가 적은
        줄을 내가 못 지우는 불편만 남는다.

        항목은 목록 문서 아래가 아니라 보드 아래 평평하게 산다. `collectionId` 로만
        어느 목록인지를 가리킨다.
      */
      match /collections/{collectionId} {
        allow read, delete: if isBoardMember(boardId);
        allow create, update: if isBoardMember(boardId)
          && withinSize()
          && data().title is string && data().title.size() <= 100
          && data().order is number;
      }

      match /collectionItems/{itemId} {
        allow read, delete: if isBoardMember(boardId);
        allow create, update: if isBoardMember(boardId)
          && withinSize()
          && data().collectionId is string && data().collectionId.size() <= 200
          && data().title is string && data().title.size() <= 500
          && data().completed is bool
          && (data().completedAt == null
              || (data().completedAt is string && data().completedAt.size() <= 40))
          && data().order is number;
      }

      /*
        메모 — 게시판처럼 쌓이는 글.

        `pinned` 가 보드 위 한 줄에 뜰 글을 정한다. 살아 있는 고정을 하나로 두는 것은
        화면의 규칙이고 규칙으로 세지 않는다 — 두 사람이 동시에 고정해 잠깐 둘이 되는
        것보다, 그때 쓰기가 거절돼 적은 것이 사라지는 쪽이 나쁘다.
      */
      match /notes/{noteId} {
        allow read, delete: if isBoardMember(boardId);
        allow create, update: if isBoardMember(boardId)
          && withinSize()
          && data().title is string && data().title.size() <= 200
          && data().body is string && data().body.size() <= 20000
          && data().pinned is bool
          && data().authorUid is string;
      }

      /** D-Day. 'D-23' 같은 문자열은 저장하지 않는다 — 날짜와 제목뿐이다. */
      match /ddays/{ddayId} {
        allow read, delete: if isBoardMember(boardId);
        allow create, update: if isBoardMember(boardId)
          && withinSize()
          && data().title is string && data().title.size() <= 100
          && isDateISO(data().date)
          && data().order is number;
      }
    }

    match /sharedInvites/{code} {
      /*
        **정확한 코드로 한 건만** 읽는다. 목록 조회는 소유자에게만 열려 있다 — 코드가
        문서 id 라서 목록 없이는 자기가 뿌린 링크를 되찾아 끊을 수도 없다.
        문서에는 보드 id 와 보드 이름만 있고, 소유자의 이메일도 보드 내용도 없다.
      */
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;

      allow create: if signedIn()
        && withinSize()
        && data().ownerUid == request.auth.uid
        && data().boardId is string
        && data().boardName is string && data().boardName.size() <= 100
        && data().createdAt is string
        // 남의 보드로 가는 초대장은 낼 수 없다.
        && boardData(data().boardId).ownerUid == request.auth.uid;

      // 고칠 일이 없다. 바꾸려면 끊고 새로 만든다.
      allow update: if false;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // 명시하지 않은 경로는 전부 막는다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
